# Copy this file to backend/.env (and create frontend/.env if/when the
# frontend needs its own VITE_ variables — none are required yet).
#
# Never commit real .env files. Never put secrets in anything prefixed
# VITE_ — those get bundled into public frontend code.

# ---- backend/.env ----
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Comma-separated for multiple origins in production, e.g.:
# CORS_ORIGIN=https://henilenterprise.com,https://www.henilenterprise.com
# Never set this to "*" — this API accepts writes and file uploads; an
# open CORS policy on it is not safe under any circumstance.

# Rate limiting — see backend/src/config/rateLimit.config.js. Defaults
# shown are generous for real traffic and restrictive for scripted
# abuse; only override if real usage patterns need it.
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_WRITE_MAX=10

# Required for the RFQ system (/quote) and file uploads to actually work.
# Without these, the server still starts, but POST /api/inquiries and
# POST /api/uploads return 503 rather than silently faking success — see
# backend/src/config/supabaseClient.js.
#
# SUPABASE_SERVICE_ROLE_KEY is a secret with full database access,
# bypassing Row Level Security entirely. It must ONLY ever exist here,
# in backend/.env — never in frontend/.env, never in anything prefixed
# VITE_, never committed. The frontend never talks to Supabase directly;
# it only calls this Express backend, which is what makes keeping this
# key server-side-only straightforward.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inquiry-drawings

# Transactional email (Resend — see database/README.md's sibling, the
# root README's "Email notifications" section, for full setup steps).
# RESEND_API_KEY is a secret: backend/.env only, never VITE_-prefixed,
# never committed. Without it, inquiries still save successfully — email
# is best-effort notification, not a requirement for the RFQ to work.
RESEND_API_KEY=
EMAIL_FROM=Henil Enterprise <onboarding@resend.dev>
HENIL_NOTIFICATION_EMAIL=
EMAIL_RESPONSE_MESSAGE=Our team will review your inquiry and get back to you as soon as possible.

# File upload limits — keep these in sync with the VITE_ versions below.
# Only the backend values are actually enforced; the frontend ones are UX
# convenience (immediate feedback) only.
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,dxf,dwg
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=5

# ---- frontend/.env ----
# Public-facing only — anything prefixed VITE_ is bundled into the public
# frontend JS and visible to anyone who views the site.
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
# Two independently-configurable templates. {product} is replaced with
# the real product name when a visitor is on a product page — see
# FloatingWhatsAppButton.jsx. Falls back to the default template
# whenever there's no page context to fill {product} with.
VITE_WHATSAPP_MESSAGE_DEFAULT=Hello Henil Enterprise, I am interested in your acrylic/polycarbonate fabrication services.
VITE_WHATSAPP_MESSAGE_PRODUCT=Hello Henil Enterprise, I am interested in {product}.
VITE_PHONE_NUMBER=+91-XXXXXXXXXX
VITE_CONTACT_EMAIL=info@henilenterprise.com
VITE_ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,dxf,dwg
VITE_MAX_UPLOAD_SIZE_MB=20
VITE_MAX_UPLOAD_FILES=5

# Brochure — see frontend/public/brochure/README.md. Defaults to a local
# file at that exact path; override with a full URL to host it elsewhere.
VITE_BROCHURE_URL=/brochure/henil-enterprise-brochure.pdf
VITE_BROCHURE_FILENAME=Henil-Enterprise-Brochure.pdf

# Local SEO / NAP fields — see frontend/src/config/company.config.js
# (the canonical configuration area for company identity) and
# frontend/src/config/localBusiness.config.js (map/geo/hours).
# City/state/country are already hardcoded in company.config.js since
# they're confirmed; everything below is genuinely unconfirmed and left
# blank on purpose. Filling these in strengthens local search and
# Google Business Profile matching, but nothing here is invented as a
# placeholder value the way "+91-XXXXXXXXXX" above is — leaving them
# blank simply omits that field from the site's structured data rather
# than showing a fake address.
VITE_STREET_ADDRESS=
VITE_POSTAL_CODE=
VITE_GEO_LATITUDE=
VITE_GEO_LONGITUDE=
# From Google Maps: Share → Embed a map → copy the src="..." URL. Only
# needed once there's a precise address to pin; until then the site
# falls back to a city-level Ahmedabad, Gujarat map.
VITE_GOOGLE_MAPS_EMBED_URL=
VITE_BUSINESS_HOURS_NOTE=

# ---- Website identity — company.config.js ----
# The real production domain, no trailing slash (e.g.
# https://www.henilenterprise.com). Used for canonical URLs, Open Graph,
# and structured data `url`/`@id` fields. Falls back to
# window.location.origin in the browser if left blank, so this only
# matters once a real domain is live.
VITE_SITE_URL=
# Overrides the default business description used in Organization /
# LocalBusiness structured data — only set this if the wording needs to
# change from the default already written in company.config.js.
VITE_BUSINESS_DESCRIPTION=

# ---- Social / profile links — company.config.js ----
# Every one of these is blank unless a real profile exists. Each
# populated value becomes a schema.org `sameAs` entry — see
# utils/structuredData.js. Nothing is invented as a placeholder handle.
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=
VITE_GOOGLE_BUSINESS_PROFILE_URL=

# ---- Google Search Console + Google Analytics — see SEO-SETUP.md ----
# HTML meta-tag verification code from Search Console (Settings →
# Ownership verification → HTML tag → copy only the content="..."
# value). Injected into index.html via Vite's built-in %VITE_...% HTML
# replacement — never hardcoded in the repo.
VITE_GSC_VERIFICATION_CODE=
# GA4 Measurement ID (format: G-XXXXXXXXXX) from Analytics → Admin →
# Data Streams → your web stream. Analytics is fully inactive — no
# script loads, no requests are sent — until this is set. See
# frontend/src/hooks/useAnalytics.js.
VITE_GA_MEASUREMENT_ID=

# Added in later phases (do not fill in yet):
# EMAIL_API_KEY=
